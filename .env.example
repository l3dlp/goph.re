# GitHub OAuth credentials
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret
GITHUB_CALLBACK_URL=http://localhost:4447/auth/github/callback

# Discord webhook notified for each new article (leave empty to disable)
DISCORD_WEBHOOK_URL=

# Optional: pin outbound connections to one local IPv4 address
# (all outbound traffic is IPv4-only either way; empty lets the kernel choose)
LOCAL_IPV4=
